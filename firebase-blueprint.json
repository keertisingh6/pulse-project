{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and academic configuration",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 255 },
        "college": { "type": "string", "maxLength": 150 },
        "branch": { "type": "string", "maxLength": 100 },
        "semester": { "type": "string", "maxLength": 30 },
        "studyRhythm": { "type": "string", "enum": ["morning", "night", "balanced"] },
        "focusBlockMinutes": { "type": "number" },
        "dailyAvailableHours": { "type": "number" },
        "streakDays": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Commitment": {
      "title": "Commitment",
      "description": "Student coursework, assignment, exam, or life commitment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "dueTime": { "type": "string", "maxLength": 20 },
        "estimatedEffort": { "type": "string", "maxLength": 50 },
        "effortMinutes": { "type": "number" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string", "maxLength": 50 },
        "source": { "type": "string", "enum": ["manual", "life_inbox", "google_tasks"] },
        "googleTaskId": { "type": "string", "maxLength": 128 },
        "googleTaskListId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "aiTip": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "dueDate", "completed"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Long-term academic or personal target milestone",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["exam", "career", "academic", "skill", "personal"] },
        "icon": { "type": "string", "maxLength": 50 },
        "targetDate": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 1000 },
        "color": { "type": "string", "maxLength": 30 },
        "progressPercentage": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "targetDate"]
    },
    "FocusSession": {
      "title": "FocusSession",
      "description": "Completed pomodoro or study block session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "durationMinutes": { "type": "number" },
        "type": { "type": "string", "enum": ["work", "study", "break"] },
        "completedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "durationMinutes", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document storing academic settings and credentials"
    },
    "/users/{userId}/commitments/{commitmentId}": {
      "schema": { "$ref": "#/entities/Commitment" },
      "description": "User commitments, assignments, exams, and synced Google Tasks"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User goals and milestones"
    },
    "/users/{userId}/focusSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/FocusSession" },
      "description": "Focus timer history and statistics"
    }
  }
}
