rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'name', 'college', 'branch', 'semester', 'studyRhythm', 'focusBlockMinutes', 'dailyAvailableHours', 'streakDays', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId &&
        data.email is string && data.email.size() <= 255 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
        (!('college' in data) || (data.college is string && data.college.size() <= 150)) &&
        (!('branch' in data) || (data.branch is string && data.branch.size() <= 100)) &&
        (!('semester' in data) || (data.semester is string && data.semester.size() <= 30)) &&
        (!('studyRhythm' in data) || (data.studyRhythm in ['morning', 'night', 'balanced'])) &&
        (!('focusBlockMinutes' in data) || data.focusBlockMinutes is number) &&
        (!('dailyAvailableHours' in data) || data.dailyAvailableHours is number) &&
        (!('streakDays' in data) || data.streakDays is number);
    }

    // Commitment Validation
    function isValidCommitment(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'dueDate', 'completed']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'type', 'subject', 'description', 'dueDate', 'dueTime', 'estimatedEffort', 'effortMinutes', 'priority', 'completed', 'completedAt', 'source', 'googleTaskId', 'googleTaskListId', 'notes', 'aiTip', 'createdAt', 'status']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.dueDate is string && data.dueDate.size() <= 20 &&
        data.completed is bool &&
        (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('dueTime' in data) || (data.dueTime is string && data.dueTime.size() <= 20)) &&
        (!('estimatedEffort' in data) || (data.estimatedEffort is string && data.estimatedEffort.size() <= 50)) &&
        (!('effortMinutes' in data) || data.effortMinutes is number) &&
        (!('priority' in data) || (data.priority in ['high', 'medium', 'low'])) &&
        (!('source' in data) || (data.source in ['manual', 'life_inbox', 'google_tasks'])) &&
        (!('googleTaskId' in data) || (data.googleTaskId is string && data.googleTaskId.size() <= 128)) &&
        (!('googleTaskListId' in data) || (data.googleTaskListId is string && data.googleTaskListId.size() <= 128)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('aiTip' in data) || (data.aiTip is string && data.aiTip.size() <= 500)) &&
        (!('status' in data) || (data.status in ['pending', 'in_progress', 'completed', 'overdue']));
    }

    // Goal Validation
    function isValidGoal(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'targetDate']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'category', 'icon', 'targetDate', 'description', 'color', 'progressPercentage', 'milestones', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.targetDate is string && data.targetDate.size() <= 20 &&
        (!('category' in data) || (data.category in ['exam', 'career', 'academic', 'skill', 'personal'])) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 30)) &&
        (!('progressPercentage' in data) || data.progressPercentage is number) &&
        (!('milestones' in data) || (data.milestones is list && data.milestones.size() <= 50));
    }

    // Focus Session Validation
    function isValidFocusSession(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'durationMinutes', 'type']) &&
        data.keys().hasOnly(['id', 'userId', 'durationMinutes', 'type', 'completedAt', 'notes', 'commitmentId']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.durationMinutes is number && data.durationMinutes > 0 && data.durationMinutes <= 720 &&
        data.type in ['work', 'study', 'break'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('commitmentId' in data) || (data.commitmentId is string && data.commitmentId.size() <= 128));
    }

    // Test connection document for app initialization check
    match /test/connection {
      allow read: if true;
    }

    // User Resource Root
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user listing forbidden

      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid && incoming().email == existing().email;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Commitments & Synced Google Tasks
      match /commitments/{commitmentId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(commitmentId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) && isValidId(userId) && isValidId(commitmentId) &&
          incoming().id == commitmentId &&
          isValidCommitment(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(userId) && isValidId(commitmentId) &&
          isValidCommitment(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          (
            // Toggle completed status action
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'completedAt', 'status']) ||
            // Full details edit action
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'type', 'subject', 'description', 'dueDate', 'dueTime', 'estimatedEffort', 'effortMinutes', 'priority', 'notes', 'aiTip', 'status', 'completed', 'completedAt'])
          );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(commitmentId);
      }

      // Subcollection: Goals
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(goalId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) && isValidId(userId) && isValidId(goalId) &&
          incoming().id == goalId &&
          isValidGoal(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(userId) && isValidId(goalId) &&
          isValidGoal(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id;

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(goalId);
      }

      // Subcollection: Focus Sessions
      match /focusSessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) &&
          incoming().id == sessionId &&
          isValidFocusSession(incoming(), userId);

        allow update: if false; // Focus session records are immutable historical logs
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
  }
}
